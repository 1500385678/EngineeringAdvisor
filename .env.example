# EngineeringAdvisor · environment variables sample
# ==================================================
# Mirrors `api/core/config.py` (Pydantic Settings).
# Copy to `.env` and adjust as needed.
# `.env` is in .gitignore; this file is the canonical team onboarding doc.
# Field semantics live in `api/core/config.py` (`Field(description=...)`).

# ── Runtime mode ─────────────────────────────────
# dev | test | staging | prod
ENV=dev

# Enable debug (uvicorn reload, verbose logs)
DEBUG=false

# ── Server bind ──────────────────────────────────
# Used by `python -m api.main` and docker-compose
HOST=0.0.0.0
PORT=8000

# ── CORS ─────────────────────────────────────────
# Comma-separated; Pydantic Settings parses to list[str]
# Default ["http://localhost:3000"] for Next.js dev
CORS_ALLOW_ORIGINS=http://localhost:3000

# ── Logging ──────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
