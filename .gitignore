# ============================================
# EngineeringAdvisor · 全栈 .gitignore
# 维护:29-工程 cron · 2026-08-25 初版
# 覆盖:Next.js + FastAPI + Python + Node + IDE + OS
# ============================================

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
.Trashes

# ---------- 环境变量(永远不入库) ----------
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test

# ---------- Next.js / Web 产物 ----------
.next/
out/
.swc/
build/
dist/
.turbo/
.vercel
next-env.d.ts

# ---------- Node / 包管理 ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# ---------- Python / FastAPI ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
*.egg-info/
*.egg
pip-log.txt
pip-delete-this-directory.txt
dist/
build/

# ---------- IDE / 编辑器 ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
.cursor/
*.sublime-project
*.sublime-workspace

# ---------- 日志与运行时 ----------
*.log
logs/
pids/
*.pid
*.seed
*.pid.lock

# 2026-09-05 修补:行 78 *.log 模式误匹配 .Log/ 目录下的 .md 文件
# 实测 git 2.50.1 (Apple Git-155):touch .Log/test.md → git check-ignore 命中行 78
# 0901-0904 共 4 个状态记录均需 git add -f 强制入库(0902 db050bf commit message 已记录)
# 修补方案:在 *.log 之后加 !.Log/ 显式重新包含整个 .Log/ 目录
# 副作用:.Log/ 下任何 .log 也不会被忽略——但 .Log/ 当前仅 12 巡检 + 4 状态记录 .md,无 .log
!.Log/

# ---------- 临时 / 缓存 ----------
tmp/
.tmp/
.temp/
.cache/
.parcel-cache/
.eslintcache
.stylelintcache

# ---------- 文档构建 ----------
docs/_build/
site/
.mkdocs/

# ---------- 数据库 / 数据文件(本地) ----------
*.sqlite
*.sqlite3
*.db
data/local/
uploads/

# ---------- 监控 / 遥测(可选) ----------
.sentryclirc
coverage/
.nyc_output/

# ---------- Docker / 部署 ----------
*.pid
docker-compose.override.yml

# ---------- 项目特定 ----------
# 计划与日志文件不入库(可选;若需版本控制,改为 ! 排除)
.Log/*.local.md
.plan/*.local.md
